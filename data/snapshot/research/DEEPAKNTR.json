  "overview": [
   {
    "sourceId": "ar-2026",
    "page": 78,
    "excerpt": "The opportunities before us are significant, and we are confident that the investments being undertaken today will meaningfully expand our future earnings potential and reinforce Deepak Nitrite’s position as one of India’s leading",
    "section": "Corporate overview"
