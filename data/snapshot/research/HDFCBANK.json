 "business": {
  "status": "ok",
  "overview": [
   {
    "sourceId": "ar-2026",
    "page": 202,
    "excerpt": "We Are HDFC Bank’s cultural transformation journey continued to gain momentum, driven by the belief that culture is the invisible force shaping performance, collaboration, customer experience and innovation. During the year, the Bank focussed on nurturing a culture that is adaptive, inclusive, empathetic and customer centric.",
    "section": "Corporate overview"
   },
   {
    "sourceId": "ar-2026",
    "page": 253,
    "excerpt": "HDFC Bank Parivartan, is one of the Bank's most longstanding community initiatives. The campaign is in response to India's continuing need for blood, which is critical for accident victims, cancer patients, children with medical conditions and people requiring regular transfusions. It aims to strengthen the national blood supply while encouraging a culture of voluntary donation.",
    "section": "Corporate overview"
   },
   {
    "sourceId": "ar-2026",
    "page": 121,
    "excerpt": "HDFC Bank is one of the largest players in Real Estate Finance. The team consists of experts across various aspects of Real Estate and related products. The business is geographically",
    "section": "Leadership message"
   }
  ],
  "segments": null,
  "management": [
   {
    "sourceId": "call-2026-10",
    "page": 3,
    "excerpt": "The pace of retail disbursements is accelerating and has crossed Rs 90,000 crores during Q2 FY27 as against Rs 76,000 crores in Q1 of this year. Growth has been balanced across all lines, whether it's personal loans, the wheels business, gold and agri and other MSME business as well.",
    "speaker": "Sashidhar Jagdishan"
   },
   {
    "sourceId": "call-2026-10",
    "page": 4,
    "excerpt": "Daily disbursal run rate of key retail and MSME products are up by 10% to 20% versus the prior quarter. Our asset quality remains pristine, with GNPA at 1.11%, 13 basis points lower than year- on-year. Credit costs remain low at 44 basis points, the risk weights to total assets at 69%. Our industry-leading asset quality metrics reflect the top-quartile credit quality choices we have consistently made.",
    "speaker": "Sashidhar Jagdishan"
   }
  ]
 },
