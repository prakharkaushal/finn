# dependencies
/node_modules
/.pnp
.pnp.*

# Next.js build output and generated types (regenerated by next dev / build / typegen)
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# env files — never commit secrets; .env.example is the safe template
.env*
!.env.example
*.pem

# FINN runtime cache: fetched pages, documents, extracted PDF text. Regenerated on demand.
/.cache/

# deployment
.vercel

# tests and browser runs
/coverage
/test-results/
/playwright-report/

# local databases and logs
*.sqlite
*.sqlite3
*.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# local AI-tool settings (build history is exported and linked separately)
.claude/settings.local.json

# The ENAM challenge brief PDFs live in the working folder but are not ours to publish.
/*.pdf

# Local draft of the submission email (contains placeholders; not part of the repo)
/SUBMISSION_EMAIL.md
